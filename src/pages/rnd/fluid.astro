---
import FluidCursor from '../../islands-rnd/fluid/FluidCursor';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>R&D: fluid cursor</title>
    <style>
      body {
        margin: 0;
        background: #0e0f12;
        color: #cfd3da;
        font-family: system-ui, sans-serif;
      }
      .hero {
        position: relative;
        height: 100svh;
        overflow: hidden;
      }
      .hero h1 {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        margin: 0;
        pointer-events: none;
        font-weight: 500;
        letter-spacing: 0.04em;
      }
      .filler {
        padding: 4rem 1.5rem;
        max-width: 40rem;
        margin: 0 auto;
        line-height: 1.6;
      }
    </style>
  </head>
  <body>
    <section class="hero">
      <FluidCursor client:load />
      <h1>fluid cursor spike</h1>
    </section>
    <div class="filler">
      <p>
        Scroll-test filler. On touch devices, vertical swipes over the hero must still scroll the
        page (touch-action: pan-y), while sideways smears advect the field.
      </p>
      {Array.from({ length: 12 }).map((_, i) => <p>Filler paragraph {i + 1}.</p>)}
    </div>
  </body>
</html>
