---
import type { CollectionEntry } from 'astro:content';

interface Props {
  skills: CollectionEntry<'skills'>[];
}
const { skills } = Astro.props;
---

<div class="chips" data-skill-chips role="group" aria-label="Filter projects by skill">
  {
    skills.map((s) => (
      <button
        type="button"
        data-skill-chip={s.id}
        data-category={s.data.category}
        aria-pressed="false"
      >
        <span class="dot" aria-hidden="true" />
        {s.data.label}
      </button>
    ))
  }
</div>

<script>
  import { EV, type SkillSelectDetail } from '../lib/events';

  // Chips only *dispatch*; all DOM state (aria-pressed, card filtering, announcements)
  // is applied by the single listener in src/scripts/filter-projects.ts.
  // Module scripts run once per session under view transitions, so binding is
  // re-run (idempotently) on every astro:page-load.
  function bindChips(): void {
    document
      .querySelectorAll<HTMLButtonElement>('[data-skill-chip]:not([data-bound])')
      .forEach((chip) => {
        chip.dataset.bound = 'true';
        chip.addEventListener('click', () => {
          const active = chip.getAttribute('aria-pressed') === 'true';
          const detail: SkillSelectDetail = {
            skillId: active ? null : (chip.dataset.skillChip ?? null),
          };
          window.dispatchEvent(new CustomEvent(EV.skillSelect, { detail }));
        });
      });
  }
  bindChips();
  document.addEventListener('astro:page-load', bindChips);
</script>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  button {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.45em 0.9em;
    background: transparent;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    cursor: pointer;
    transition:
      border-color var(--dur-quick) var(--ease-out),
      color var(--dur-quick) var(--ease-out);
  }
  button:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }
  button[aria-pressed='true'] {
    color: var(--color-bg-deep);
    background: var(--color-accent);
    border-color: var(--color-accent);
    font-weight: 600;
  }
  .dot {
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: var(--color-text-muted);
  }
  button[data-category='language'] .dot {
    background: var(--node-language);
  }
  button[data-category='framework'] .dot {
    background: var(--node-framework);
  }
  button[data-category='platform'] .dot {
    background: var(--node-platform);
  }
  button[data-category='practice'] .dot {
    background: var(--node-practice);
  }
  button[aria-pressed='true'] .dot {
    background: var(--color-bg-deep);
  }
</style>
