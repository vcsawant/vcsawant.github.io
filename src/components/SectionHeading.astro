---
interface Props {
  eyebrow: string;
  title: string;
  id?: string;
}
const { eyebrow, title, id } = Astro.props;
---

<header class="section-heading">
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id}>{title}</h2>
</header>

<style>
  .section-heading {
    margin-bottom: var(--space-5);
  }
  h2 {
    font-size: var(--text-2xl);
    margin-top: var(--space-2);
  }
</style>
