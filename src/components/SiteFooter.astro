---
import { site } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="site-footer" id="contact">
  <div class="wrap">
    <p class="eyebrow">endgame</p>
    <h2>Get in touch</h2>
    <p class="pitch">
      {'{{TODO: one-line availability/contact pitch from Viren — see CONTENT-TODO.md}}'}
    </p>
    <ul class="channels">
      <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      {
        site.linkedin && (
          <li>
            <a href={site.linkedin} rel="me">
              LinkedIn
            </a>
          </li>
        )
      }
      {
        site.github && (
          <li>
            <a href={site.github} rel="me">
              GitHub
            </a>
          </li>
        )
      }
      {
        site.resumeAvailable && (
          <li>
            <a href="/resume.pdf">Resume (PDF)</a>
          </li>
        )
      }
    </ul>
    <p class="colophon">
      &copy; {year} Viren Sawant · Astro on Cloudflare Workers ·
      <a href="https://github.com/vcsawant/vcsawant.github.io">source</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-line);
    background:
      linear-gradient(color-mix(in srgb, var(--color-bg-deep) 60%, transparent), transparent),
      repeating-conic-gradient(
          from 0deg,
          color-mix(in srgb, var(--color-surface) 40%, transparent) 0% 25%,
          transparent 0% 50%
        )
        0 0 / 4rem 4rem;
    padding-block: var(--space-7) var(--space-5);
    margin-top: var(--space-8);
  }
  h2 {
    font-size: var(--text-2xl);
    margin-block: var(--space-2) var(--space-3);
  }
  .channels {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
    list-style: none;
    padding: 0;
    margin-block: var(--space-4);
  }
  .colophon {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-top: var(--space-6);
  }
</style>
