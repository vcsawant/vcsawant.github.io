---
const year = new Date().getFullYear();
---

<footer class="site-footer" id="contact">
  <div class="wrap">
    <p class="eyebrow">endgame</p>
    <h2>Get in touch</h2>
    <p class="pitch">
      {'{{TODO: one-line availability/contact pitch from Viren — see CONTENT-TODO.md}}'}
    </p>
    <ul class="channels">
      <li><a href="mailto:viren.c.sawant@gmail.com">viren.c.sawant@gmail.com</a></li>
      <li>
        <a href="{{TODO: LinkedIn URL}}" rel="me">LinkedIn</a>
      </li>
      <li>
        <a href="{{TODO: GitHub URL}}" rel="me">GitHub</a>
      </li>
      <li><a href="/resume.pdf">Resume (PDF)</a></li>
    </ul>
    <p class="colophon">
      &copy; {year} Viren Sawant · Astro + three.js on Cloudflare Workers ·
      <a href="https://github.com/vcsawant/vcsawant.github.io">source</a>
