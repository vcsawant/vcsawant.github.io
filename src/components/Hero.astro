---
/*
 * Static hero. The text below is the LCP element — permanently. The WebGL hero
 * (Phase 5) mounts inside [data-hero-canvas], absolutely positioned BEHIND this
 * text, so it can never affect layout or LCP.
 */
import { site } from '../lib/site';
import HeroScene from '../islands/hero/HeroScene';
---

<section class="hero">
  <div class="hero-canvas" data-hero-canvas aria-hidden="true">
    {
      /* poster is the default (also the no-JS visual); fallback.ts swaps in the
        WebM on webgl-less browsers, or hides both once the canvas is live */
    }
    <picture data-hero-poster>
      <source srcset="/fallback/hero.avif" type="image/avif" />
      <img src="/fallback/hero.jpg" alt="" decoding="async" fetchpriority="low" />
    </picture>
    <video
      data-hero-video
      src="/fallback/hero.webm"
      poster="/fallback/hero.jpg"
      muted
      loop
      playsinline
      preload="none"
      hidden></video>
    <HeroScene client:idle />
  </div>
  <div class="wrap hero-copy">
    <p class="eyebrow">opening</p>
    <h1>Viren Sawant</h1>
    <p class="positioning">
      {
        '{{TODO: real positioning line from Viren. Placeholder: Technical consultant and co-founder. I own delivery: architecture, code, and shipping. — see CONTENT-TODO.md}}'
      }
    </p>
    <div class="cta-row">
      <a class="cta primary" href="#work">See the work</a>
      {
        site.resumeAvailable ? (
          <a class="cta" href="/resume.pdf">
            Resume (PDF)
          </a>
        ) : (
          <a class="cta" href="#contact">
            Get in touch
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(92dvh - 4rem);
    display: grid;
    align-items: center;
    overflow: hidden;
    background: radial-gradient(
      120% 90% at 70% 20%,
      color-mix(in srgb, var(--color-surface) 70%, var(--color-bg)) 0%,
      var(--color-bg) 55%,
      var(--color-bg-deep) 100%
    );
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    /* canvas / fallback video / poster mounts here; never in flow.
     * Decorative only: pointer events pass through to text and CTAs.
     * The fluid sim reads pointer input from the section, not the canvas. */
    pointer-events: none;
  }
  .hero-canvas picture,
  .hero-canvas img,
  .hero-canvas video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-copy {
    position: relative;
    z-index: 1;
    padding-block: var(--space-7);
  }
  h1 {
    font-size: var(--text-hero);
    font-weight: 620;
    margin-block: var(--space-2) var(--space-3);
  }
  .positioning {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 44ch;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .cta {
    display: inline-block;
    padding: 0.7em 1.4em;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--text-sm);
    letter-spacing: 0.03em;
    transition: border-color var(--dur-quick) var(--ease-out);
  }
  .cta:hover,
  .cta:focus-visible {
    border-color: var(--color-accent);
  }
  .cta.primary {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-bg-deep);
    font-weight: 600;
  }
  .cta.primary:hover,
  .cta.primary:focus-visible {
    background: var(--color-text);
    border-color: var(--color-text);
  }
</style>
